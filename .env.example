# Copy to .env next to docker-compose.prod.yml and fill in.

# GitHub owner (user or org) the image was published under.
GHCR_OWNER=your-github-username

# Which published tag to run. Pin a release (v0.9.0) or track latest.
IMAGE_TAG=latest

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install token.
# In the tunnel's public hostname config, point the service at: http://app:8080
CLOUDFLARE_TUNNEL_TOKEN=

# Largest accepted paste, in bytes (5 MiB). Raise it if you paste big screenshots.
MAX_PASTE_BYTES=5242880

# Lifetime used when the client doesn't pick one, in seconds.
DEFAULT_TTL_SECONDS=600
